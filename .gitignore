# This repository holds a language-agnostic specification plus one or more implementations
# under impl/. Keep this file sectioned the same way: shared rules first, then one section per
# implementation stack.
#
# Add a stack section when that implementation lands — not before. Rules for stacks that do not
# exist are noise nobody dares to delete later.

# ── Shared ────────────────────────────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*~

# Local environment
.env
.env.*
!.env.example

# ── impl/typescript ───────────────────────────────────────────────────────────
node_modules/
dist/
coverage/
*.tsbuildinfo
*.tgz
.npm
.eslintcache
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions

# ── impl/python (prototype) ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
